{
  "expo": {
    "name": "Augment Lab",
    "slug": "augment-lab",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/store/icon-aram-ios-1024.png",
    "scheme": "augmentlab",
    "userInterfaceStyle": "automatic",
    "locales": {
      "ko": "./assets/locales/ko.json"
    },
    "ios": {
      "icon": "./assets/store/icon-aram-ios-1024.png",
      "bundleIdentifier": "com.augmentlab",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F12",
        "foregroundImage": "./assets/store/adaptive-foreground.png",
        "backgroundImage": "./assets/store/adaptive-background.png",
        "monochromeImage": "./assets/store/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.augmentlab"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F12",
          "image": "./assets/store/adaptive-foreground.png",
          "imageWidth": 220,
          "android": {
            "image": "./assets/store/adaptive-foreground.png",
            "imageWidth": 220
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc6939d3-df92-44f8-82b8-703d52156302"
      }
    },
    "owner": "dwhddnjs"
  }
}
